<ui:FluentWindow x:Class="SnakeTailAI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:SnakeTailAI.ViewModels"
                 xmlns:views="clr-namespace:SnakeTailAI.Views"
                 xmlns:controls="clr-namespace:SnakeTailAI.Controls"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="SnakeTail AI" Icon="pack://application:,,,/Assets/app.ico" Width="1400" Height="860" MinWidth="820" MinHeight="480"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen" AllowDrop="True"
                 Topmost="{Binding AlwaysOnTop}">

    <ui:FluentWindow.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ClearCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
        <KeyBinding Gesture="F3" Command="{Binding FindNextCommand}" />
        <KeyBinding Gesture="Shift+F3" Command="{Binding FindPreviousCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding FocusFilterCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+X" Command="{Binding ClearFilterCommand}" />
        <KeyBinding Gesture="Ctrl+F2" Command="{Binding ToggleBookmarkCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding NextBookmarkCommand}" />
        <KeyBinding Gesture="Shift+F2" Command="{Binding PreviousBookmarkCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding ToggleDetailsCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleBrowserCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding ToggleColumnsCommand}" />
        <KeyBinding Gesture="Alt+Z" Command="{Binding ToggleWrapCommand}" />
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomResetCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding GoToTimeCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+G" Command="{Binding ToggleGroupsCommand}" />
        <KeyBinding Gesture="F11" Command="{Binding ToggleFocusModeCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding ToggleFilterBarCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+T" Command="{Binding ToggleTerminalCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <!-- Tab strip -->
        <Style x:Key="TabStrip" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,6">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabStripItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,0,4,0">
                            <Border x:Name="Bd" CornerRadius="8" Padding="11,4,5,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Accent" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="14,0,14,0"
                                    Background="{DynamicResource Log.Accent}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                <Setter TargetName="Accent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type vm:LogTabViewModel}">
            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding ToolTip}">
                <StackPanel.InputBindings>
                    <MouseBinding Gesture="MiddleClick" Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                </StackPanel.InputBindings>
                <StackPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Close" InputGestureText="Ctrl+W"
                                  Command="{Binding PlacementTarget.Tag.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Close other tabs"
                                  Command="{Binding PlacementTarget.Tag.CloseOtherTabsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Copy full path"
                                  Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Show in Explorer"
                                  Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </StackPanel.ContextMenu>
                <StackPanel.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                </StackPanel.Tag>
                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" MaxWidth="260" TextTrimming="CharacterEllipsis" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding HeaderNote}" MaxWidth="160" TextTrimming="CharacterEllipsis" FontSize="11" Margin="6,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Visibility="{Binding HeaderNote, Converter={StaticResource NullToVis}}" />
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding UnseenErrors, Converter={StaticResource CountToVis}}" ToolTip="New errors since you last looked at this tab">
                    <TextBlock Text="{Binding UnseenErrors}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Style="{StaticResource ToolButton}" Height="24" MinWidth="24" Padding="4" Margin="6,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Close (Ctrl+W)">
                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="12" />
                </Button>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="SnakeTail AI" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================== Toolbar ============================== -->
        <DockPanel Grid.Row="1" Margin="12,0,12,8" LastChildFill="False"
                   Visibility="{Binding FocusMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowBrowser}" ToolTip="Devices panel (Ctrl+B)">
                    <ui:SymbolIcon Symbol="PanelLeft24" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenFileCommand}" ToolTip="Open log file (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                        <TextBlock Text="Open" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenSeriesOfCurrentCommand}" IsEnabled="{Binding HasTabs}"
                        ToolTip="Open this log together with all its rotated files (.log.1 … .log.N)">
                    <ui:SymbolIcon Symbol="DocumentMultiple24" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NewTimelineCommand}" AutomationProperties.Name="Timeline"
                        ToolTip="Timeline: merge the logs of several devices in time order">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timeline24" />
                        <TextBlock Text="Timeline" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenSshCommand}" IsEnabled="{Binding HasTabs}"
                        Visibility="{Binding SshEnabled, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="SSH"
                        ToolTip="SSH terminal on the device of this log (in a timeline: the device of the selected line)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WindowConsole20" />
                        <TextBlock Text="SSH" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Style="{StaticResource ToolSeparator}" />

                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SelectedTab.IsFollowing}" IsEnabled="{Binding HasTabs}"
                              ToolTip="Follow the end of the file (End)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDown24" />
                        <TextBlock Text="Follow" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SelectedTab.IsPaused}" IsEnabled="{Binding HasTabs}"
                              ToolTip="Pause the view; new lines are kept and shown on resume (Space)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pause24" />
                        <TextBlock Text="Pause" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearCommand}" IsEnabled="{Binding HasTabs}"
                        ToolTip="Clear the screen (Ctrl+L). The log file is not touched; Reload brings the lines back.">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Broom24" />
                        <TextBlock Text="Clear" Margin="6,0,2,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ReloadCommand}" IsEnabled="{Binding HasTabs}" ToolTip="Reload from the file (F5)">
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </Button>

                <Border Style="{StaticResource ToolSeparator}" />

                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowFilterBar}" IsEnabled="{Binding HasTabs}"
                              ToolTip="Show / hide the filters (Ctrl+Shift+F)" AutomationProperties.Name="Filters">
                    <ui:SymbolIcon Symbol="Filter24" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Command="{Binding FindCommand}" IsEnabled="{Binding HasTabs}" ToolTip="Find (Ctrl+F, F3 / Shift+F3)">
                    <ui:SymbolIcon Symbol="Search24" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding GoToTimeCommand}" IsEnabled="{Binding HasTabs}" ToolTip="Go to time (Ctrl+G)" AutomationProperties.Name="Go to time">
                    <ui:SymbolIcon Symbol="CalendarClock24" />
                </Button>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SelectedTab.ShowGroups}" IsEnabled="{Binding HasTabs}" AutomationProperties.Name="Message groups"
                              ToolTip="Message groups: similar messages counted together (Ctrl+Shift+G)">
                    <ui:SymbolIcon Symbol="GroupList24" />
                </ToggleButton>
                <Button x:Name="BookmarksButton" Style="{StaticResource ToolButton}" Click="OnBookmarksClick" IsEnabled="{Binding HasTabs}"
                        ToolTip="Bookmarks (Ctrl+F2 toggle, F2 / Shift+F2 jump)">
                    <ui:SymbolIcon Symbol="Bookmark24" />
                </Button>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SelectedTab.ColumnsMode}" IsEnabled="{Binding HasTabs}" ToolTip="Columns view (Ctrl+T)">
                    <ui:SymbolIcon Symbol="Table24" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SelectedTab.WordWrap}" IsEnabled="{Binding HasTabs}" ToolTip="Word wrap (Alt+Z)">
                    <ui:SymbolIcon Symbol="TextWrap24" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding SelectedTab.ShowDetails}" IsEnabled="{Binding HasTabs}" ToolTip="Line details (Ctrl+D)">
                    <ui:SymbolIcon Symbol="Info24" />
                </ToggleButton>
                <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="OnExportClick" IsEnabled="{Binding HasTabs}" ToolTip="Export lines to a file">
                    <ui:SymbolIcon Symbol="ArrowExportLtr24" />
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource ToolButton}" Click="OnAlertsClick" AutomationProperties.Name="Alerts" ToolTip="Alerts: Windows notification or sound when a new line matches">
                    <Grid>
                        <ui:SymbolIcon Symbol="Alert24" Visibility="{Binding AlertsMuted, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                        <ui:SymbolIcon Symbol="AlertOff24" Foreground="{DynamicResource Log.Warning}"
                                       Visibility="{Binding AlertsMuted, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="OnHighlightsClick" ToolTip="Highlight rules">
                    <ui:SymbolIcon Symbol="Color24" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Light / dark theme">
                    <Grid>
                        <ui:SymbolIcon Symbol="WeatherSunny24" Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVis}}" />
                        <ui:SymbolIcon Symbol="WeatherMoon24" Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleFocusModeCommand}" ToolTip="Focus mode: only the log, as tall as possible (F11)"
                        AutomationProperties.Name="Focus mode">
                    <ui:SymbolIcon Symbol="FullScreenMaximize24" />
                </Button>
                <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding AlwaysOnTop}" ToolTip="Always on top">
                    <ui:SymbolIcon Symbol="Pin24" />
                </ToggleButton>
                <Button Style="{StaticResource ToolButton}" Click="OnSettingsClick" ToolTip="Settings">
                    <ui:SymbolIcon Symbol="Settings24" />
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- ============================== Main area ============================== -->
        <Grid Grid.Row="2" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BrowserColumn" Width="290" MinWidth="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="10" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <views:BrowserPanel x:Name="Browser" DataContext="{Binding Browser}" />
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"
                          x:Name="Splitter" DragCompleted="OnSplitterDragCompleted" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="TerminalRow" Height="0" />
                </Grid.RowDefinitions>

                <ListBox Style="{StaticResource TabStrip}" ItemContainerStyle="{StaticResource TabStripItem}" ItemTemplate="{StaticResource TabHeaderTemplate}"
                         ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}" />

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LogTabViewModel}">
                            <views:LogTabView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ============================== Terminal panel ============================== -->
                <GridSplitter x:Name="TerminalSplitter" Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext" Background="Transparent" Visibility="Collapsed"
                              DragCompleted="OnTerminalSplitterDragCompleted" />
                <Border x:Name="TerminalPanel" Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,2" Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="10,3,4,3">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource ToolButton}" Height="28" Padding="8,0" Command="{Binding SelectedTerminal.ReconnectCommand}"
                                        ToolTip="Connect again">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowClockwise20" />
                                        <TextBlock Text="Reconnect" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Height="28" Command="{Binding CloseTerminalCommand}" ToolTip="Close this session">
                                    <ui:SymbolIcon Symbol="Dismiss20" />
                                </Button>
                                <Button Style="{StaticResource ToolButton}" Height="28" Command="{Binding ToggleTerminalCommand}" ToolTip="Hide the terminal (Ctrl+Shift+T)">
                                    <ui:SymbolIcon Symbol="ChevronDown20" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="WindowConsole20" Margin="0,0,6,0" Foreground="{DynamicResource Log.Accent}" />
                                <TextBlock Text="TERMINAL" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ListBox Style="{StaticResource TabStrip}" ItemContainerStyle="{StaticResource TabStripItem}"
                                         ItemsSource="{Binding Terminals}" SelectedItem="{Binding SelectedTerminal}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:TerminalSessionViewModel}">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource ToolButton}" Height="22" MinWidth="22" Padding="3" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.CloseTerminalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" ToolTip="Close this session">
                                                    <ui:SymbolIcon Symbol="Dismiss20" FontSize="11" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Terminals}" Focusable="False" Margin="1,0,1,1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TerminalSessionViewModel}">
                                    <views:SshTerminalView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <!-- Empty state -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,34" MaxWidth="560">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Assets/app.png" Width="84" Height="84" HorizontalAlignment="Center" />
                            <TextBlock Text="SnakeTail AI" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="Live log viewer with filters, highlights and rotation support" Style="{StaticResource Caption}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,4,0,22" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button Content="Open log file…" Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Primary" Padding="16,8"
                                           Command="{Binding OpenFileCommand}" />
                                <ui:Button Content="Show devices" Icon="{ui:SymbolIcon PanelLeft24}" Padding="16,8" Margin="10,0,0,0"
                                           Command="{Binding ToggleBrowserCommand}" />
                            </StackPanel>
                            <TextBlock Text="RECENT" Style="{StaticResource SectionTitle}" Margin="0,28,0,6"
                                       Visibility="{Binding RecentFiles.Count, Converter={StaticResource CountToVis}}" />
                            <ItemsControl ItemsSource="{Binding RecentFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Cursor="Hand" ToolTip="{Binding}" Focusable="False">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" CornerRadius="6" Padding="8,6" Background="Transparent">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="DocumentText20" Margin="0,0,10,0" Foreground="{DynamicResource Log.Accent}" />
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Converter={StaticResource FileName}}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Tip: drop log files anywhere in this window" Style="{StaticResource Caption}" FontSize="11.5"
                                       HorizontalAlignment="Center" Margin="0,22,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================== Status bar ============================== -->
        <Grid Grid.Row="3" Visibility="{Binding FocusMode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
        <DockPanel Margin="16,6,16,8" DataContext="{Binding SelectedTab}"
                   Visibility="{Binding Converter={StaticResource NullToVis}}" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Border CornerRadius="10" Padding="9,2,10,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" FontSize="12" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Run Text="Lines" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding TotalLines, Mode=OneWay, StringFormat=N0}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Run Text="Shown" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding ShownLines, Mode=OneWay, StringFormat=N0}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Run Text="Size" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding FileSize, Mode=OneWay, Converter={StaticResource SizeText}}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0"
                           Visibility="{Binding Rotations, Converter={StaticResource CountToVis}}">
                    <Run Text="Rotations" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Run Text="{Binding Rotations, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="14,0,0,0" Text="{Binding Path}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <controls:Sparkline Width="120" Height="20" Values="{Binding RateHistory}" Version="{Binding RateVersion}"
                                    Stroke="{DynamicResource Log.Accent}" ToolTip="Lines per second, last 60 s" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="80">
                    <Run Text="{Binding LinesPerSecond, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Run Text="lines/s" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </TextBlock>
            </StackPanel>
        </DockPanel>
        </Grid>

        <!-- Focus mode: a way back -->
        <Border Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="12" Padding="12,2,4,2"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}" WindowChrome.IsHitTestVisibleInChrome="True"
                Visibility="{Binding FocusMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Focus mode" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource ToolButton}" Height="24" Margin="8,0,0,0" Padding="8,0" Command="{Binding ExitFocusModeCommand}"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Show toolbar, devices, filters and status bar again (F11)">
                    <TextBlock Text="Exit  (F11)" FontSize="12" />
                </Button>
            </StackPanel>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" Margin="0,0,0,40" />
    </Grid>
</ui:FluentWindow>
