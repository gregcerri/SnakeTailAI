<ui:FluentWindow x:Class="SnakeTailAI.Views.AlertsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SnakeTailAI.Views"
                 Title="Alerts" Width="980" Height="560" MinWidth="760" MinHeight="360"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Alerts" ShowMinimize="False" />

        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="Add alert" Icon="{ui:SymbolIcon Add24}" Click="OnAdd" />
                    <ui:Button Content="Test notification" Icon="{ui:SymbolIcon Alert24}" Margin="8,0,0,0" Click="OnTest" />
                    <CheckBox x:Name="MutedBox" Content="Mute all alerts" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Save" Appearance="Primary" MinWidth="100" IsDefault="True" Click="OnSave" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,6,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Text="When a new line of an open log matches, SnakeTail AI shows a Windows notification and/or plays a sound — also when its tab is in the background. Each alert fires at most once every 30 seconds per tab; lines in between are counted. Click the notification to jump to the line." />

            <Grid Grid.Row="1" Margin="12,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ON" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="1" Text="TEXT IN THE LINE" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="2" Text="OPTIONS" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="3" Text="LEVEL" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="4" Text="NOTIFICATION" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="5" Text="SOUND" Style="{StaticResource SectionTitle}" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AlertRow}">
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <ui:ToggleSwitch IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"
                                                PlaceholderText="Text or regex (term1; term2) — empty: any line of that level" FontFamily="{StaticResource MonoFont}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource OptionToggle}" Content=".*" IsChecked="{Binding IsRegex}" ToolTip="Regular expression" />
                                        <ToggleButton Style="{StaticResource OptionToggle}" Content="Aa" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="3" SelectedIndex="{Binding LevelIndex}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ComboBoxItem Content="Any level" />
                                        <ComboBoxItem Content="WARN or ERROR" />
                                        <ComboBoxItem Content="ERROR only" />
                                    </ComboBox>
                                    <ui:ToggleSwitch Grid.Column="4" IsChecked="{Binding ShowNotification}" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch Grid.Column="5" IsChecked="{Binding PlaySound}" VerticalAlignment="Center" />
                                    <Button Grid.Column="6" Style="{StaticResource ToolButton}" Click="OnDelete" Tag="{Binding}" ToolTip="Delete">
                                        <ui:SymbolIcon Symbol="Delete20" Foreground="{DynamicResource Log.Error}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
