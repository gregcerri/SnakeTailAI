<UserControl x:Class="SnakeTailAI.Views.BrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:SnakeTailAI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BrowserViewModel}"
             d:DesignWidth="290" d:DesignHeight="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="4,2,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Refresh">
                <ui:SymbolIcon Symbol="ArrowClockwise20" />
            </Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="Timeline: merge the logs of several devices in time order"
                    Command="{Binding DataContext.NewTimelineCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                <ui:SymbolIcon Symbol="Timeline24" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="DEVICES" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="{Binding Root}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Root}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <ui:TextBox Grid.Row="1" PlaceholderText="Filter devices…" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" Margin="0,0,0,10"
                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <!-- Root missing -->
                <Border Style="{StaticResource Card}" Padding="14" Visibility="{Binding RootMissing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="FolderProhibited24" FontSize="28" HorizontalAlignment="Left" Foreground="{DynamicResource Log.Warning}" />
                        <TextBlock Text="Log folder not found" FontWeight="SemiBold" Margin="0,8,0,2" />
                        <TextBlock Text="Set the folder that holds the device logs in Settings." TextWrapping="Wrap" Style="{StaticResource Caption}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding DevicesView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                            <Border x:Name="CardBorder" Style="{StaticResource Card}" Padding="10,9" Margin="0,0,0,7" Cursor="Hand"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding ActivateCommand}" />
                                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenLiveCommand}" />
                                </Border.InputBindings>
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open live log" Command="{Binding OpenLiveCommand}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="Live24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open full series (all rotated files)" Command="{Binding OpenSeriesCommand}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="DocumentMultiple24" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open SSH terminal" Command="{Binding OpenSshCommand}"
                                                  Visibility="{Binding CanSsh, Converter={StaticResource BoolToVis}}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="WindowConsole20" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Open folder in Explorer" Command="{Binding OpenFolderCommand}">
                                            <MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <ui:SymbolIcon x:Name="DeviceIcon" Symbol="Desktop24" FontSize="20" Foreground="{DynamicResource Log.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                <Run Text="{Binding Subtitle, Mode=OneWay}" />
                                                <Run Text="·" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                <Run Text="·" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                <Run Text="{Binding LastWriteText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0">
                                            <Border CornerRadius="7" Padding="6,1" Margin="0,0,6,0" Background="{DynamicResource Log.Accent}"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}" ToolTip="Open in a tab">
                                                <TextBlock Text="open" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <Ellipse x:Name="LiveDot" Width="9" Height="9" Fill="{DynamicResource TextFillColorDisabledBrush}" VerticalAlignment="Center"
                                                     ToolTip="Live when written in the last 30 seconds" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <ui:Button Content="Live" Icon="{ui:SymbolIcon Live24}" Appearance="Primary" Padding="10,4" FontSize="12"
                                                   Command="{Binding OpenLiveCommand}" IsEnabled="{Binding HasLog}" ToolTip="Follow the active log" />
                                        <ui:Button Margin="6,0,0,0" Padding="10,4" FontSize="12" Icon="{ui:SymbolIcon DocumentMultiple24}"
                                                   Command="{Binding OpenSeriesCommand}" IsEnabled="{Binding HasLog}" ToolTip="Open the active log with all its rotated files">
                                            <TextBlock><Run Text="Series" /><Run Text="{Binding ArchiveCount, Mode=OneWay, StringFormat=' +{0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                                        </ui:Button>
                                        <Button Style="{StaticResource ToolButton}" Height="28" Margin="6,0,0,0" Command="{Binding OpenSshCommand}"
                                                ToolTip="Open an SSH terminal on this device">
                                            <Button.Visibility>
                                                <MultiBinding Converter="{StaticResource AllTrueToVis}">
                                                    <Binding Path="CanSsh" />
                                                    <Binding Path="DataContext.SshEnabled" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </Button.Visibility>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="WindowConsole20" />
                                                <TextBlock Text="SSH" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton Style="{StaticResource ToolToggle}" Height="28" Margin="2,0,0,0" IsChecked="{Binding IsExpanded}" ToolTip="Show files">
                                            <ui:SymbolIcon Symbol="ChevronDown20" />
                                        </ToggleButton>
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,8,0,0"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LogFileViewModel}">
                                                <Button Command="{Binding OpenCommand}" Cursor="Hand" ToolTip="{Binding Path}" Focusable="False">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" CornerRadius="5" Padding="6,4" Background="Transparent">
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Caption}" FontSize="11" Margin="8,0,0,0" />
                                                                    <ui:SymbolIcon Symbol="DocumentText20" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource MonoFont}" />
                                                                        <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="10.5" />
                                                                    </StackPanel>
                                                                </DockPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                    <Setter TargetName="LiveDot" Property="Fill" Value="{DynamicResource Log.Live}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                    <Setter TargetName="DeviceIcon" Property="Symbol" Value="FolderOpen24" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Log.Accent}" />
                                    <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="CardBorder" Property="Padding" Value="9,8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasLog}" Value="False">
                                    <Setter TargetName="CardBorder" Property="Opacity" Value="0.55" />
                                </DataTrigger>
                                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource Caption}" FontSize="11" Margin="4,8,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
