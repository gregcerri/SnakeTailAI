<ui:FluentWindow x:Class="SnakeTailAI.Views.HighlightEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SnakeTailAI.Views"
                 Title="Highlight rules" Width="1060" Height="640" MinWidth="820" MinHeight="380"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="Swatch">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="3" Background="{Binding}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,8,0" />
                <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Highlight rules" ShowMinimize="False" />

        <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <ui:Button Content="Add rule" Icon="{ui:SymbolIcon Add24}" Click="OnAdd" />
                    <ui:Button Content="Restore defaults" Margin="8,0,0,0" Click="OnDefaults" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Save" Appearance="Primary" MinWidth="100" IsDefault="True" Click="OnSave" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" MinWidth="100" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="20,6,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,0,0,10"
                       Text="Rules are checked top to bottom. A whole-line rule colours the full line (the first match wins); the others colour only the matched text. Colours are #RRGGBB or #AARRGGBB (AA = transparency)." />

            <Grid Grid.Row="1" Margin="12,0,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="94" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ON" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="1" Text="PATTERN" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="2" Text="OPTIONS" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="3" Text="TEXT COLOUR" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="4" Text="BACKGROUND" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="5" Text="STYLE" Style="{StaticResource SectionTitle}" />
                <TextBlock Grid.Column="6" Text="PREVIEW" Style="{StaticResource SectionTitle}" />
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RulesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RuleRow}">
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="94" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <ui:ToggleSwitch IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                    <ui:TextBox Grid.Column="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Text or regex"
                                                FontFamily="{StaticResource MonoFont}" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource OptionToggle}" Content=".*" IsChecked="{Binding IsRegex}" ToolTip="Regular expression" />
                                        <ToggleButton Style="{StaticResource OptionToggle}" Content="Aa" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="3" IsEditable="True" Margin="0,0,8,0" ItemsSource="{x:Static local:RuleRow.Colors}"
                                              ItemTemplate="{StaticResource Swatch}" Text="{Binding Foreground, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox Grid.Column="4" IsEditable="True" Margin="0,0,8,0" ItemsSource="{x:Static local:RuleRow.Backgrounds}"
                                              ItemTemplate="{StaticResource Swatch}" Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource OptionToggle}" IsChecked="{Binding Bold}" ToolTip="Bold">
                                            <TextBlock Text="B" FontWeight="Bold" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource OptionToggle}" IsChecked="{Binding WholeLine}" ToolTip="Colour the whole line" Width="44">
                                            <TextBlock Text="line" FontSize="11" />
                                        </ToggleButton>
                                    </StackPanel>
                                    <Border Grid.Column="6" CornerRadius="5" Padding="8,4" Margin="0,0,8,0" Background="{DynamicResource Log.Background}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PreviewText}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding PreviewForeground}" Background="{Binding PreviewBackground}"
                                                   FontWeight="{Binding PreviewWeight}" />
                                    </Border>
                                    <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ToolButton}" Click="OnUp" Tag="{Binding}" ToolTip="Move up"><ui:SymbolIcon Symbol="ArrowUp20" /></Button>
                                        <Button Style="{StaticResource ToolButton}" Click="OnDown" Tag="{Binding}" ToolTip="Move down"><ui:SymbolIcon Symbol="ArrowDown20" /></Button>
                                        <Button Style="{StaticResource ToolButton}" Click="OnDelete" Tag="{Binding}" ToolTip="Delete"><ui:SymbolIcon Symbol="Delete20" Foreground="{DynamicResource Log.Error}" /></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
