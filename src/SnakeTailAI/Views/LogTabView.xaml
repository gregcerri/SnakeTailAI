<UserControl x:Class="SnakeTailAI.Views.LogTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SnakeTailAI.Controls"
             xmlns:vm="clr-namespace:SnakeTailAI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:LogTabViewModel}"
             d:DesignWidth="1100" d:DesignHeight="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Filter card ============================== -->
        <!-- Filters hidden but active: a slim reminder -->
        <Border Padding="10,4" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.FilterBarVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                <Condition Binding="{Binding IsFilterActive}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource ToolButton}" Height="26" Padding="8,0" ToolTip="Show the filters (Ctrl+Shift+F)"
                            Command="{Binding DataContext.ToggleFilterBarCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="Show filters" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Height="26" Padding="8,0" Command="{Binding ClearFilterCommand}" ToolTip="Clear all filters">
                        <TextBlock Text="Clear" FontSize="12" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Filter24" FontSize="14" Foreground="{DynamicResource Log.Accent}" Margin="0,0,8,0" />
                    <TextBlock FontSize="12" VerticalAlignment="Center">
                        <Run Text="Filter active · showing" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding ShownLines, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" />
                        <Run Text="of" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Run Text="{Binding TotalLines, Mode=OneWay, StringFormat=N0}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="10,9,10,8" Margin="0,0,0,8"
                Visibility="{Binding DataContext.FilterBarVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="IncludeBox" PlaceholderText="Include — show only lines containing…  (term1; term2)"
                                Icon="{ui:SymbolIcon Filter24}" ClearButtonEnabled="True"
                                Text="{Binding Include, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox Grid.Column="2" PlaceholderText="Exclude — hide lines containing…"
                                Icon="{ui:SymbolIcon FilterDismiss24}" ClearButtonEnabled="True"
                                Text="{Binding Exclude, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,4,0" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource OptionToggle}" Content=".*" IsChecked="{Binding IsRegex}" ToolTip="Use regular expressions" />
                        <ToggleButton Style="{StaticResource OptionToggle}" Content="Aa" IsChecked="{Binding MatchCase}" ToolTip="Match case" />
                        <ToggleButton Style="{StaticResource OptionToggle}" IsChecked="{Binding WholeWord}" ToolTip="Whole word">
                            <TextBlock Text="ab" TextDecorations="Underline" />
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource ToolToggle}" IsChecked="{Binding ShowAdvancedFilter}" ToolTip="Thread, source and time filters">
                            <ui:SymbolIcon Symbol="Options24" />
                        </ToggleButton>
                        <Button x:Name="PresetsButton" Style="{StaticResource ToolButton}" Click="OnPresetsClick" ToolTip="Filter presets">
                            <ui:SymbolIcon Symbol="FilterAdd20" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ClearFilterCommand}" ToolTip="Clear all filters">
                            <ui:SymbolIcon Symbol="EraserTool24" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- thread / source / time -->
                <Grid Margin="0,8,0,0" Visibility="{Binding ShowAdvancedFilter, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="Thread  (e.g. 10-31584)" Icon="{ui:SymbolIcon Stack24}" ClearButtonEnabled="True"
                                Text="{Binding Thread, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox Grid.Column="2" PlaceholderText="Source file or function" Icon="{ui:SymbolIcon Code24}" ClearButtonEnabled="True"
                                Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox Grid.Column="4" PlaceholderText="From  HH:mm:ss" Icon="{ui:SymbolIcon Clock24}" ClearButtonEnabled="True"
                                Text="{Binding TimeFrom, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Time of day (HH:mm[:ss]) or full date (yyyy-MM-dd HH:mm:ss)" />
                    <ui:TextBox Grid.Column="6" PlaceholderText="To  HH:mm:ss" Icon="{ui:SymbolIcon ClockArrowDownload24}" ClearButtonEnabled="True"
                                Text="{Binding TimeTo, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Time of day (HH:mm[:ss]) or full date (yyyy-MM-dd HH:mm:ss)" />
                    <ui:TextBox Grid.Column="7" Width="230" Margin="8,0,0,0" PlaceholderText="Device  (31; -29 hides)" Icon="{ui:SymbolIcon Desktop24}"
                                ClearButtonEnabled="True" Text="{Binding Device, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding IsMerged, Converter={StaticResource BoolToVis}}"
                                ToolTip="Devices to show, separated by ;  —  a name starting with - is hidden" />
                </Grid>

                <!-- level chips + counters -->
                <DockPanel Margin="0,9,0,0" LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <ToggleButton Style="{StaticResource LevelChip}" Tag="{DynamicResource Log.Error}" IsChecked="{Binding ShowError}" ToolTip="Errors">
                            <TextBlock><Run Text="ERROR" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding ErrorCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LevelChip}" Tag="{DynamicResource Log.Warning}" IsChecked="{Binding ShowWarning}" ToolTip="Warnings">
                            <TextBlock><Run Text="WARN" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding WarningCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LevelChip}" Tag="{DynamicResource Log.Info}" IsChecked="{Binding ShowInfo}" ToolTip="Info">
                            <TextBlock><Run Text="INFO" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding InfoCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LevelChip}" Tag="{DynamicResource Log.Debug}" IsChecked="{Binding ShowDebug}" ToolTip="Debug and trace">
                            <TextBlock><Run Text="DEBUG" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding DebugCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource LevelChip}" Tag="{DynamicResource Log.Other}" IsChecked="{Binding ShowOther}" ToolTip="Lines without a level">
                            <TextBlock><Run Text="OTHER" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding OtherCount, Mode=OneWay, StringFormat=N0}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,8,0"
                                         Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Foreground="{DynamicResource Log.Error}" FontSize="12" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   Text="{Binding FilterError}" Visibility="{Binding FilterError, Converter={StaticResource NullToVis}}" />
                        <Border CornerRadius="10" Padding="9,2" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="12">
                                <Run Text="Showing" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding ShownLines, Mode=OneWay, StringFormat=N0}" FontWeight="SemiBold" />
                                <Run Text="of" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Run Text="{Binding TotalLines, Mode=OneWay, StringFormat=N0}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ============================== Find bar ============================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,7" Margin="0,0,0,8"
                Visibility="{Binding IsFindOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox x:Name="FindBox" Width="340" PlaceholderText="Find in shown lines…" Icon="{ui:SymbolIcon Search24}"
                            Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnFindKeyDown" />
                <ToggleButton Style="{StaticResource OptionToggle}" Content=".*" IsChecked="{Binding FindRegex}" Margin="8,0,2,0" ToolTip="Regular expression" />
                <ToggleButton Style="{StaticResource OptionToggle}" Content="Aa" IsChecked="{Binding FindMatchCase}" ToolTip="Match case" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding FindPreviousCommand}" ToolTip="Previous match (Shift+F3)" Margin="8,0,0,0">
                    <ui:SymbolIcon Symbol="ArrowUp24" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding FindNextCommand}" ToolTip="Next match (F3)">
                    <ui:SymbolIcon Symbol="ArrowDown24" />
                </Button>
                <TextBlock Text="{Binding FindStatus}" VerticalAlignment="Center" Margin="10,0" Style="{StaticResource Caption}" MinWidth="90" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding CloseFindCommand}" ToolTip="Close (Esc)">
                    <ui:SymbolIcon Symbol="Dismiss24" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ============================== Log view ============================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Message groups -->
            <Border Grid.Column="1" Width="440" Margin="8,0,0,0" Style="{StaticResource Card}" Padding="10,8"
                    Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0"
                                             Visibility="{Binding IsGrouping, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshGroupsCommand}" ToolTip="Count again">
                                <ui:SymbolIcon Symbol="ArrowClockwise20" />
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleGroupsCommand}" ToolTip="Close (Ctrl+Shift+G)">
                                <ui:SymbolIcon Symbol="Dismiss20" />
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MESSAGE GROUPS" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{Binding GroupsStatus}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox DockPanel.Dock="Top" Margin="0,6,0,6" Content="Only warnings and errors" IsChecked="{Binding GroupsProblemsOnly}" />
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                               Text="Messages that differ only in numbers are counted together. Double-click a group to find its lines; right-click to filter." />
                    <ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Find these lines" Command="{Binding FindGroupCommand}" CommandParameter="{Binding SelectedGroup}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Search24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Show only these lines" Command="{Binding OnlyGroupCommand}" CommandParameter="{Binding SelectedGroup}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Filter24" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Hide these lines" Command="{Binding HideGroupCommand}" CommandParameter="{Binding SelectedGroup}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="FilterDismiss24" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Copy message" Command="{Binding CopyGroupCommand}" CommandParameter="{Binding SelectedGroup}">
                                    <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="Transparent" ToolTip="{Binding First.Raw}">
                                    <Grid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                      Command="{Binding DataContext.FindGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Count, StringFormat=N0}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,1,10,0" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                    <Grid Grid.Column="1" VerticalAlignment="Top" Margin="0,1,8,0" MinWidth="44">
                                        <Border CornerRadius="4" Background="{Binding Level, Converter={StaticResource LevelBrush}}" Opacity="0.18" />
                                        <TextBlock Text="{Binding Level, Converter={StaticResource LevelName}}" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" HorizontalAlignment="Center" Margin="6,1" />
                                    </Grid>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Template}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Source, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border CornerRadius="8" Background="{DynamicResource Log.Background}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="1" ClipToBounds="True">
                <controls:LogViewControl x:Name="LogView"
                                         Document="{Binding Document}"
                                         Highlighter="{Binding Highlighter}"
                                         FindMatcher="{Binding FindMatcher}"
                                         FindMarks="{Binding FindMarks}"
                                         MarksVersion="{Binding MarksVersion}"
                                         ColumnsMode="{Binding ColumnsMode}"
                                         WordWrap="{Binding WordWrap}"
                                         IsFollowing="{Binding IsFollowing}"
                                         IsPaused="{Binding IsPaused}"
                                         LogFontSize="{Binding FontSize}"
                                         LogFontFamily="{Binding DataContext.LogFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                                         FadeIn="{Binding DataContext.FadeIn, RelativeSource={RelativeSource AncestorType=Window}}"
                                         LineSpacing="{Binding DataContext.LineSpacing, RelativeSource={RelativeSource AncestorType=Window}}"
                                         ColumnWidths="{Binding DataContext.ColumnWidths, RelativeSource={RelativeSource AncestorType=Window}}"
                                         SelectedLine="{Binding SelectedLine}"
                                         ContextLine="{Binding ContextLine}"
                                         EmptyText="{Binding EmptyText}">
                    <controls:LogViewControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopyLinesCommand}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Copy message only" Command="{Binding CopyMessageCommand}" CommandParameter="{Binding ContextLine}" />
                            <Separator />
                            <MenuItem Header="Toggle bookmark" InputGestureText="Ctrl+F2" Command="{Binding ToggleBookmarkCommand}" CommandParameter="{Binding ContextLine}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Bookmark24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Line details" InputGestureText="Ctrl+D" Command="{Binding ToggleDetailsCommand}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Show in context (clear filter)" Command="{Binding ShowInContextCommand}" CommandParameter="{Binding ContextLine}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="TextWrap24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Only this thread" Command="{Binding OnlyThreadCommand}" CommandParameter="{Binding ContextLine}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Stack24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hide this thread" Command="{Binding ExcludeThreadCommand}" CommandParameter="{Binding ContextLine}" />
                            <MenuItem Header="Only this source file" Command="{Binding OnlySourceCommand}" CommandParameter="{Binding ContextLine}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Code24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hide this source file" Command="{Binding ExcludeSourceCommand}" CommandParameter="{Binding ContextLine}" />
                            <MenuItem Header="Only this function" Command="{Binding OnlyFunctionCommand}" CommandParameter="{Binding ContextLine}" />
                            <MenuItem Header="Only this level" Command="{Binding OnlyLevelCommand}" CommandParameter="{Binding ContextLine}" />
                            <MenuItem Header="Only this device" Command="{Binding OnlyDeviceCommand}" CommandParameter="{Binding ContextLine}"
                                      Visibility="{Binding ContextLine.Origin, Converter={StaticResource NullToVis}}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Desktop24" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Hide this device" Command="{Binding HideDeviceCommand}" CommandParameter="{Binding ContextLine}"
                                      Visibility="{Binding ContextLine.Origin, Converter={StaticResource NullToVis}}" />
                            <MenuItem Header="Include this message" Command="{Binding IncludeMessageCommand}" CommandParameter="{Binding ContextLine}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="Filter24" /></MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Export selection…" Command="{Binding ExportSelectionCommand}">
                                <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExportLtr24" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </controls:LogViewControl.ContextMenu>
                </controls:LogViewControl>
            </Border>

            <!-- Paused pill -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" CornerRadius="18" Padding="14,6,6,6"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource Log.Warning}" BorderThickness="1"
                    Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Pause24" Foreground="{DynamicResource Log.Warning}" VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,12,0">
                        <Run Text="Paused" FontWeight="SemiBold" />
                        <Run Text="·" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <Run Text="{Binding PendingWhilePaused, Mode=OneWay, StringFormat='+{0:N0} new lines'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </TextBlock>
                    <ui:Button Content="Resume" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Padding="10,4" Command="{Binding FollowTailCommand}" />
                </StackPanel>
            </Border>

            <!-- Jump to latest -->
            <ui:Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,22" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowDown24}" Content="Latest" Padding="10,5" Command="{Binding FollowTailCommand}" ToolTip="Follow the end of the file (End)">
                <ui:Button.Style>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFollowing}" Value="False" />
                                    <Condition Binding="{Binding IsPaused}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Button.Style>
            </ui:Button>

            <!-- Loading card -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Width="320" CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="{Binding LoadProgress, StringFormat=P0}" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                        <TextBlock Text="Loading log…" FontWeight="SemiBold" />
                    </DockPanel>
                    <ProgressBar Margin="0,10,0,0" Height="4" Minimum="0" Maximum="1" Value="{Binding LoadProgress}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================== Line details ============================== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,10"
                Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource ToolButton}" Command="{Binding CopyMessageCommand}" ToolTip="Copy message">
                            <ui:SymbolIcon Symbol="Copy24" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ShowInContextCommand}" ToolTip="Show in context (clear filter)">
                            <ui:SymbolIcon Symbol="TextWrap24" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleDetailsCommand}" ToolTip="Close (Ctrl+D)">
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </Button>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center" DataContext="{Binding SelectedLine}">
                        <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding Origin, Converter={StaticResource NullToVis}}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Origin}" />
                        </Border>
                        <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Text="{Binding Timestamp, Converter={StaticResource TimestampText}}" />
                        </Border>
                        <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Level, Converter={StaticResource LevelName}}"
                                       Foreground="{Binding Level, Converter={StaticResource LevelBrush}}" />
                        </Border>
                        <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding ThreadText, Converter={StaticResource NullToVis}}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"><Run Text="thread " Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding ThreadText, Mode=OneWay}" /></TextBlock>
                        </Border>
                        <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding SourceText, Converter={StaticResource NullToVis}}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"><Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text=":" Foreground="{DynamicResource TextFillColorTertiaryBrush}" /><Run Text="{Binding SourceLineText, Mode=OneWay}" /></TextBlock>
                        </Border>
                        <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                Visibility="{Binding FunctionText, Converter={StaticResource NullToVis}}">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12"><Run Text="{Binding FunctionText, Mode=OneWay}" /><Run Text="()" Foreground="{DynamicResource TextFillColorTertiaryBrush}" /></TextBlock>
                        </Border>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Caption}" Text="{Binding Number, StringFormat='line #{0:N0}'}" />
                    </WrapPanel>
                </DockPanel>
                <TextBox Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource MonoFont}" FontSize="13" Text="{Binding SelectedLine.Raw, Mode=OneWay}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
